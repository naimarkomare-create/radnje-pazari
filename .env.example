NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLEANUP_SECRET=your-cleanup-secret
CRON_SECRET=your-cron-secret

# Server-only BizniSoft production integration. An empty password is supported.
BIZNISOFT_SOAP_URL=http://your-biznisoft-host:port/soap/IBSWebService
BIZNISOFT_COMPANY_ID=your-company-id
BIZNISOFT_COMPANY_YEAR=2026
BIZNISOFT_USERNAME=your-username
BIZNISOFT_PASSWORD=

# Safety default: price synchronization never creates tasks automatically.
AUTO_CREATE_PRICE_TASKS=false
